# BlockPay Nexus Environment Configuration Template
# DO NOT COMMIT SENSITIVE VALUES TO VERSION CONTROL

# Server & Gateway
PORT=8080
ENVIRONMENT=development
LOG_LEVEL=INFO

# Security & JWT Tokens
JWT_SECRET=bpx_super_secure_jwt_secret_key_2026_fintech_token_99x
