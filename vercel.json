{
  "version": 2,
  "name": "sentinelaix-hud",
  "cleanUrls": true,
  "public": true,
  "rewrites": [
    {
      "source": "/api/(.*)",
      "destination": "https://sentinelaix-api.onrender.com/api/$1"
    },
    {
      "source": "/health",
      "destination": "https://sentinelaix-api.onrender.com/health"
    },
    {
      "source": "/(.*)",
      "destination": "/sentinel/dashboard/$1"
    }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "X-Frame-Options",
          "value": "DENY"
        },
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "Referrer-Policy",
          "value": "strict-origin-when-cross-origin"
        }
      ]
    }
  ]
}
