{
  "info": {
    "_postman_id": "bpx-nexus-collection-2026",
    "name": "BlockPay Nexus — Full-Scale FinTech API Collection",
    "description": "Comprehensive Postman test collection for BlockPay Nexus microservices platform, covering Auth, Wallets, Transactions, Conversion, Markets, Portfolio, News, Fraud, Audit, and Health.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:8080",
      "type": "string"
    },
    {
      "key": "accessToken",
      "value": "",
      "type": "string"
    }
  ],
  "item": [
    {
      "name": "1. Health & Cluster Status",
      "item": [
        {
          "name": "Gateway Health Check",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/health",
              "host": ["{{baseUrl}}"],
              "path": ["health"]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status code is 200', function () {",
                  "    pm.response.to.have.status(200);",
                  "});",
                  "pm.test('Platform is BlockPay Nexus', function () {",
                  "    var json = pm.response.json();",
                  "    pm.expect(json.platform).to.eql('BlockPay Nexus');",
                  "    pm.expect(json.status).to.eql('HEALTHY');",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ]
        },
        {
          "name": "Microservices Cluster Telemetry",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/v1/services",
              "host": ["{{baseUrl}}"],
              "path": ["api", "v1", "services"]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status code is 200', function () {",
                  "    pm.response.to.have.status(200);",
                  "});",
                  "pm.test('All 13 microservices reporting healthy', function () {",
                  "    var json = pm.response.json();",
                  "    pm.expect(json.gateway.status).to.eql('Healthy');",
                  "    pm.expect(json.auth.status).to.eql('Healthy');",
                  "    pm.expect(json.blockchain.status).to.eql('Healthy');",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ]
        }
      ]
    },
    {
      "name": "2. Authentication & Users",
      "item": [
        {
          "name": "Login User (Kiran Nexus)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"username\": \"kiran_nexus\",\n  \"password\": \"NexusPass#2026\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/v1/auth/login",
              "host": ["{{baseUrl}}"],
              "path": ["api", "v1", "auth", "login"]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status code is 200', function () {",
                  "    pm.response.to.have.status(200);",
                  "});",
                  "pm.test('Returns JWT access token', function () {",
                  "    var json = pm.response.json();",
                  "    pm.expect(json.success).to.be.true;",
                  "    pm.expect(json.accessToken).to.be.a('string');",
                  "    pm.collectionVariables.set('accessToken', json.accessToken);",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ]
        },
        {
          "name": "Register New User",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"username\": \"test_trader_99\",\n  \"email\": \"trader99@blockpay.nexus\",\n  \"password\": \"StrongPass#2026\",\n  \"fullName\": \"Autonomous Algorithmic Trader\",\n  \"role\": \"USER\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/v1/auth/register",
              "host": ["{{baseUrl}}"],
              "path": ["api", "v1", "auth", "register"]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status code is 200 or 400 (if already exists)', function () {",
                  "    pm.expect([200, 400]).to.include(pm.response.code);",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ]
        }
      ]
    },
    {
